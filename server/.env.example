# ---- Chipperton server ----
# Copy to .env and fill in. Never commit .env.

PORT=8787
CORS_ORIGIN=http://localhost:5173

# ---- RPC ----
# Two clusters, one purpose each (PLAN.md §2).
#
# RPC_PAY is where money moves. devnet in v1.
# RPC_DATA is where jobs READ, and is ALWAYS mainnet — a token safety check
# against devnet data is worthless, so it does not follow the payment cluster.
#
# BOTH must be paid endpoints. Verified 2026-08-28: the public endpoints
# (api.mainnet-beta.solana.com, api.devnet.solana.com, solana-rpc.publicnode.com)
# return 429/403 on getAccountInfo and getTokenLargestAccounts immediately —
# devnet answers getHealth in 0.24s and still rate-limits the real calls.
# Get a free key at https://helius.dev
RPC_PAY=https://devnet.helius-rpc.com/?api-key=YOUR_KEY
RPC_PAY_WS=wss://devnet.helius-rpc.com/?api-key=YOUR_KEY
RPC_DATA=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
PAY_CLUSTER=devnet

# ---- Supabase ----
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---- Keys ----
# Two separate wallets on purpose: a leaked worker env costs the float, not
# the treasury. Generate with:
#   solana-keygen new --no-bip39-passphrase -o agent-hot.json
# then paste the JSON array below. Keep the hot wallet thin.
AGENT_HOT_SECRET=[1,2,3,...]
# Where payments land. Should NOT be the hot wallet's address.
VAULT_ADDRESS=

ANTHROPIC_API_KEY=
CHIPPERTON_MODEL=claude-sonnet-5

# ---- $CHIPS ----
# Leave CHIPS_MINT empty until launch. While it is empty the CHIPS payment path
# is gated off entirely — pump.fun is mainnet-only, so the 10% discount cannot
# function while payments are on devnet.
CHIPS_MINT=
CHIPS_DISCOUNT_PCT=10

# ---- Agent economics ----
TICK_INTERVAL_SECONDS=900
DAILY_COST_USD=18.40
QUOTE_TTL_SECONDS=60
